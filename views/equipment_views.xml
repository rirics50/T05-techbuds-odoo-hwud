<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_predictive_safety_pipeline_tree" model="ir.ui.view">
        <field name="name">predictive.safety.pipeline.tree</field>
        <field name="model">predictive.safety.pipeline</field>
        <field name="arch" type="xml">
            <list string="Pipeline Equipment" class="o_predictive_safety">
                <field name="name"/>
                <field name="material"/>
                <field name="grade"/>
                <field name="diameter"/>
                <field name="thickness"/>
                <field name="last_pressure"/>
                <field name="current_status"/>
                <field name="valve_state"/>
            </list>
        </field>
    </record>

    <record id="view_predictive_safety_pipeline_form" model="ir.ui.view">
        <field name="name">predictive.safety.pipeline.form</field>
        <field name="model">predictive.safety.pipeline</field>
        <field name="arch" type="xml">
            <form string="Pipeline Equipment" class="o_predictive_safety">
                <header>
                    <button name="force_shutdown" type="object" string="Force Shutdown"
                            class="btn-danger" confirm="Manually trigger emergency shutdown?"/>
                    <button name="reset_to_safe" type="object" string="Manual Reset"
                            class="btn-primary" invisible="current_status != 'critical'"
                            confirm="Confirm maintenance is complete and resume operations?"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="material"/>
                            <field name="grade"/>
                            <field name="current_status" widget="badge"
                                   decoration-danger="current_status == 'critical'"
                                   decoration-warning="current_status == 'warning'"
                                   decoration-success="current_status == 'safe'"/>
                            <field name="last_pressure"/>
                            <field name="temperature"/>
                            <field name="flow_rate"/>
                            <field name="last_updated"/>
                            <field name="valve_state" widget="badge"
                                   decoration-danger="valve_state == 'closed'"
                                   decoration-success="valve_state == 'open'"/>
                            <field name="valve_position"/>
                        </group>
                        <group>
                            <field name="diameter"/>
                            <field name="thickness"/>
                            <field name="corrosion_allowance"/>
                            <field name="design_temperature"/>
                            <field name="design_pressure"/>
                            <field name="flow_limit"/>
                            <field name="pipe_length"/>
                            <field name="fluid_density"/>
                            <field name="fluid_viscosity"/>
                        </group>
                    </group>
                    <group string="Engineering Results" name="engineering_results">
                        <group>
                            <field name="velocity"/>
                            <field name="reynolds_number"/>
                            <field name="friction_factor"/>
                        </group>
                        <group>
                            <field name="pressure_drop"/>
                            <field name="temperature_rate"/>
                            <field name="pressure_rate"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pressure History" name="pressure_history">
                            <field name="pressure_chart" nolabel="1" readonly="1"/>
                            <field name="reading_ids" readonly="1">
                                <list limit="10">
                                    <field name="timestamp"/>
                                    <field name="pressure"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_predictive_safety_pipeline" model="ir.actions.act_window">
        <field name="name">Pipeline Specifications</field>
        <field name="res_model">predictive.safety.pipeline</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_predictive_safety_root" name="Predictive Safety" sequence="10"/>
    <menuitem id="menu_pipeline_specs" name="Pipelines" parent="menu_predictive_safety_root" action="action_predictive_safety_pipeline" sequence="10"/>
</odoo>